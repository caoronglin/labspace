#!/usr/bin/nft -f
# labfilter —— 独立表 + 更早的优先级（-10），确保 drop 真的生效。
#
# 为什么不用 /etc/nftables.conf 里的 inet 表：
#   Tailscale 管理的 `table ip filter`（INPUT: policy accept）与 inet 表
#   挂在同一 hook、同一优先级，先返回 accept，inet 表的 drop 永远轮不到
#   （实测：inet 表加 drop dport 18099 → 仍然 200）。
#   独立表 priority -10 的 drop 能压过它（实测：200 → 000 → 200）。
#   且 tailscaled 不会重建我们的独立表，规则不会悄悄消失。
#
# 模式 normal：局域网只放行「对外入口」端口；
#              内部服务（文件核心/后端/RAG/Samba…）只走 Tailscale（WireGuard 加密）。
#
# 入口端口：22 ssh / 53 dns / 80 门户 / 8082 draw.io / 8086 命令速查 /
#           8090 Casdoor / 8091 JBrowse / 8092 SnapOtter / 8093 图纸 /
#           8094 Baserow / 8097 primer / 8102 生信实训 / 8104 AgentScope
# 幂等加载：先声明（不存在就建）→ 再删 → 最后重建。
# 不这样做的话，重复 `nft -f` 会把规则一条条叠加上去。
table ip labfilter
delete table ip labfilter
table ip labfilter {
    chain input {
        type filter hook input priority -10; policy accept;

        # —— 本机回环与 Docker 网桥：不受下面的局域网策略约束 ——
        # 宿主机自己的进程访问宿主端口（健康检查等）走 lo；
        # 容器访问宿主（nginx → backend）走 br-*。
        # 它们不是"从局域网来"的流量，不该被局域网策略拦。
        iifname "lo" accept
        iifname "br-*" accept
        iifname "veth*" accept

        # —— 局域网：只放行对外入口 ——
        ip saddr 192.0.2.0/24 tcp dport { 22, 53, 80, 8082, 8086, 8090, 8091, 8092, 8093, 8094, 8097, 8102, 8104 } accept
        ip saddr 192.0.2.0/24 udp dport 53 accept

        # —— 其余局域网流量一律拒 ——
        #   445   Samba（直接暴露 /srv/lab，明文 SMB）
        #   8001  8002 开发预览服务器（误绑 0.0.0.0）
        #   18010 lab-rag / 8122 文件核心 / 8088 后端 …
        ip saddr 192.0.2.0/24 counter drop
    }
}

table ip6 labfilter
delete table ip6 labfilter
table ip6 labfilter {
    chain input {
        type filter hook input priority -10; policy accept;
        ip6 saddr fd62:317c:ce1e::/64 tcp dport { 22, 53, 80, 8082, 8086, 8090, 8091, 8092, 8093, 8094, 8097, 8102, 8104 } accept
        ip6 saddr fd62:317c:ce1e::/64 udp dport 53 accept
        ip6 saddr fd62:317c:ce1e::/64 counter drop
    }
}
