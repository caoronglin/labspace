import { useEffect, useRef, useState } from 'react';
import { Card, Col, Flex, Row, Statistic, Typography, theme } from 'antd';
import {
  AppstoreOutlined,
  CloudServerOutlined,
  DatabaseOutlined,
  StarOutlined,
} from '@ant-design/icons';
import { tokens } from '../theme/tokens';

/** 数字滚动动画（requestAnimationFrame + easeOutCubic），用于首页指标。 */
function useCountUp(target: number, duration = 700) {
  const [value, setValue] = useState(0);
  const from = useRef(0);

  useEffect(() => {
    const start = performance.now();
    const origin = from.current;
    const delta = target - origin;
    if (delta === 0) return;

    let raf = 0;
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - p, 3);
      const next = Math.round(origin + delta * eased);
      setValue(next);
      if (p < 1) {
        raf = requestAnimationFrame(tick);
      } else {
        from.current = target;
      }
    };
    raf = requestAnimationFrame(tick);
    return () => cancelAnimationFrame(raf);
  }, [target, duration]);

  return value;
}

function StatCard({
  label,
  value,
  suffix,
  hint,
  color,
  icon,
}: {
  label: string;
  value: number;
  suffix?: string;
  hint?: string;
  color: string;
  icon: React.ReactNode;
}) {
  const { token } = theme.useToken();
  const n = useCountUp(value);
  return (
    <Card size="small" style={{ height: '100%' }}>
      <Flex gap={12} align="center">
        <span
          className="d509-icon"
          style={{
            width: 40,
            height: 40,
            borderRadius: token.borderRadiusLG,
            fontSize: 20,
            background: token.colorPrimaryBg,
            color: token.colorPrimary,
          }}
        >
          {icon}
        </span>
        <div style={{ flex: 1, minWidth: 0 }}>
          <Statistic
            title={label}
            value={n}
            suffix={suffix}
            styles={{ content: { color, fontWeight: 700, fontSize: 24, lineHeight: 1.2 } }}
          />
          {hint ? (
            <Typography.Text type="secondary" style={{ fontSize: token.fontSizeSM }}>
              {hint}
            </Typography.Text>
          ) : null}
        </div>
      </Flex>
    </Card>
  );
}

/**
 * 首页指标条：可用服务 / 当前在线 / 植物数据库 / 我的收藏。
 * 颜色收敛为「主色 + 成功色 + 1 个强调色 + 中性色」，不再写死 hex。
 */
export default function HomeStats({
  services,
  online,
  databases,
  favorites,
}: {
  services: number;
  online: number;
  databases: number;
  favorites: number;
}) {
  const { token } = theme.useToken();
  const pct = services > 0 ? Math.round((online / services) * 100) : 0;

  return (
    <Row gutter={[16, 16]}>
      <Col xs={24} sm={12} xl={6}>
        <StatCard
          label="可用服务"
          value={services}
          suffix="个"
          color={token.colorPrimary}
          icon={<AppstoreOutlined />}
        />
      </Col>
      <Col xs={24} sm={12} xl={6}>
        <StatCard
          label="当前在线"
          value={online}
          suffix={`/ ${services} 个`}
          hint={`${pct}% 正常`}
          color={token.colorSuccess}
          icon={<CloudServerOutlined />}
        />
      </Col>
      <Col xs={24} sm={12} xl={6}>
        <StatCard
          label="植物数据库"
          value={databases}
          suffix="个"
          color={tokens.colorAccent}
          icon={<DatabaseOutlined />}
        />
      </Col>
      <Col xs={24} sm={12} xl={6}>
        <StatCard
          label="我的收藏"
          value={favorites}
          suffix="个"
          color={token.colorText}
          icon={<StarOutlined />}
        />
      </Col>
    </Row>
  );
}
