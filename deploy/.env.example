# LabSpace 部署配置模板
#
# 用法：cp deploy/.env.example deploy/.env && chmod 600 deploy/.env，然后填入真实值。
# 本文件只提供键名与占位符；真实口令、会话密钥、API Key 一律不入库。
# 宿主机上的实际文件为 /opt/labspace/deploy/.env（权限 0600）。
#
# 访问方式：内网统一使用 IP + 端口，不依赖任何域名解析。
TZ=Asia/Shanghai
LABSPACE_PUBLIC_URL=http://192.0.2.10
LABSPACE_ISSUER=http://192.0.2.10:8090
LABSPACE_CLIENT_ID=labspace
LABSPACE_CLIENT_SECRET=CHANGE_ME
LABSPACE_REDIRECT_URI=http://192.0.2.10/api/auth/callback
LABSPACE_SESSION_SECRET=CHANGE_ME
LABSPACE_ALLOWED_ORIGINS=http://192.0.2.10,http://198.51.100.71
LABSPACE_DB_DSN=postgresql://labspace:CHANGE_ME@lab-postgres:5432/labspace
LABSPACE_USERS_ROOT=/srv/lab/users
LABSPACE_COOKIE_SECURE=false
# Go 核心（LabGo）：服务目录 / 健康检查 / 内嵌探测的权威实现
LABSPACE_LABGO_BASE=http://172.28.0.1:8122
CASDOOR_DB_HOST=lab-postgres
CASDOOR_DB_PORT=5432
CASDOOR_DB_NAME=casdoor
CASDOOR_DB_USER=casdoor
CASDOOR_DB_PASSWORD=CHANGE_ME
# Casdoor 内置管理员初始口令（仅首次启动、admin 口令未设置时生效）
# 生成：openssl rand -base64 18 | tr -d "\n"
CASDOOR_ADMIN_PASSWORD=CHANGE_ME
