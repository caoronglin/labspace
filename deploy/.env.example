# LabSpace 部署配置模板
#
# 用法：cp deploy/.env.example deploy/.env && chmod 600 deploy/.env，然后填入真实值。
# 本文件只提供键名与占位符；真实口令、会话密钥、API Key 一律不入库。
# 宿主机上的实际文件为 /opt/labspace/deploy/.env（权限 0600）。
#
# 访问方式：内网统一使用门户同源路径，不依赖域名解析或独立服务端口。
TZ=Asia/Shanghai
LABSPACE_PUBLIC_URL=http://192.0.2.10
LABSPACE_SESSION_SECRET=CHANGE_ME
LABSPACE_ALLOWED_ORIGINS=http://192.0.2.10,http://198.51.100.71,http://127.0.0.1,http://localhost
LABSPACE_DB_DSN=postgresql://labspace:CHANGE_ME@lab-postgres:5432/labspace
LABSPACE_USERS_ROOT=/srv/lab/users
LABSPACE_COOKIE_SECURE=false
# Go 核心（LabGo）：服务目录 / 健康检查 / 内嵌探测的权威实现
LABSPACE_LABGO_BASE=http://172.28.0.1:8122
# 账号数据库沿用原 Casdoor PostgreSQL 库；容器已下线，数据继续保留
CASDOOR_DB_HOST=lab-postgres
CASDOOR_DB_PORT=5432
CASDOOR_DB_NAME=casdoor
CASDOOR_DB_USER=casdoor
CASDOOR_DB_PASSWORD=CHANGE_ME

# Baserow：门户以「容器名 + Host 头」访问它，Baserow 按 Host 解析站点，
# 因此这里必须填 Baserow 站点配置里登记过的地址（含端口），否则会 404/Site not found。
LABSPACE_BASEROW_HOST=192.0.2.10:8094

# 入口主机白名单（X-Forwarded-Host 只在这份名单内被采信，防 SSRF）
LABSPACE_ALLOWED_HOSTS=192.0.2.10,198.51.100.71,127.0.0.1,localhost
LABSPACE_DEFAULT_ENTRY_HOST=192.0.2.10

# ── 容器编排（口令/内网地址只在部署机，不入库）──
AGENTSCOPE_DB_DSN=postgresql+asyncpg://labspace:<db-password>@lab-postgres:5432/agentscope
# 内网向量模型（bge-m3）地址：装在哪台机器就填哪台
AGENTSCOPE_EMBED_BASE=http://192.0.2.17:8000/v1/embeddings
# Qdrant API Key：即使不发布端口也要有钥匙，生成方式见 docs/DEPLOY.md
QDRANT_API_KEY=replace-with-32-bytes-of-random
BASEROW_PUBLIC_URL=http://192.0.2.10:8094
BASEROW_EXTRA_ALLOWED_HOSTS=192.0.2.10,198.51.100.71,localhost,127.0.0.1
BASEROW_EXTRA_PUBLIC_URLS=http://192.0.2.10:8094,http://198.51.100.71:8094
MAILBOX_SERVICE_PUBLIC_URL=/mail

# 端到端测试账号（跳过新手引导；逗号分隔，留空=不启用）
LABSPACE_E2E_ACCOUNTS=
